# Browser talks to EMA through Caddy. Set per server; CI does not upload this file.
# Production: https://api.emabbass.com
# Test:       https://api-test.emabbass.com  (or leave as the test API origin)
EMA_PUBLIC_API_URL=https://api.emabbass.com

NEXT_PUBLIC_DEFAULT_LOCALE=en
PORT=3000
NEXT_PUBLIC_MAX_NOTE_LENGTH=200