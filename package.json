{
	"name": "ema-portal",
	"version": "1.0.0",
	"private": true,
	"description": "EMA agent portal - Next.js + React dashboard for the EMA API (Arabic / English)",
	"scripts": {
		"dev": "next dev -p 3000",
		"build": "next build",
		"start": "next start -p 3000",
		"lint": "eslint .",
		"lint:fix": "eslint . --fix",
		"typecheck": "tsc --noEmit",
		"format": "prettier --write .",
		"format:check": "prettier --check ."
	},
	"dependencies": {
		"@stomp/stompjs": "7.0.0",
		"clsx": "2.1.1",
		"libphonenumber-js": "1.11.15",
		"lucide-react": "0.454.0",
		"next": "14.2.35",
		"react": "18.3.1",
		"react-dom": "18.3.1",
		"sockjs-client": "1.6.1"
	},
	"devDependencies": {
		"@eslint/eslintrc": "^2.1.4",
		"@types/node": "20.14.10",
		"@types/react": "18.3.12",
		"@types/react-dom": "18.3.1",
		"@types/sockjs-client": "1.5.4",
		"autoprefixer": "10.4.20",
		"eslint": "8.57.1",
		"eslint-config-next": "14.2.35",
		"eslint-config-prettier": "^9.1.0",
		"eslint-plugin-import": "^2.32.0",
		"eslint-plugin-prettier": "^5.2.1",
		"eslint-plugin-react-refresh": "^0.4.14",
		"postcss": "8.4.49",
		"prettier": "^3.3.3",
		"prettier-plugin-tailwindcss": "^0.6.8",
		"tailwindcss": "3.4.15",
		"typescript": "5.6.3"
	}
